host := "106.75.36.40"
port := "3318"

pln("=== MySQL方式查询 ===")
try {
    connStr := spr("root:@tcp(%s:%s)/?timeout=5s", host, port)
    db := dbConnect("mysql", connStr)
    if isErr(db) {
        pl("MySQL连接失败: %v", getErrStr(db))
    } else {
        pln("MySQL连接成功!")
        
        // 查版本
        rs := dbQuery(db, "SELECT VERSION()")
        if isErr(rs) {
            pl("MySQL查询版本失败: %v", getErrStr(rs))
        } else {
            pl("MySQL版本: %v", rs)
        }
        
        // 查数据库列表
        rs = dbQuery(db, "SHOW DATABASES")
        if isErr(rs) {
            pl("MySQL SHOW DATABASES失败: %v", getErrStr(rs))
        } else {
            pl("MySQL数据库列表: %v", rs)
        }
        
        dbClose(db)
    }
} catch e {
    pl("MySQL异常: %v", e)
}

pln("")
pln("=== PostgreSQL方式查询 ===")
try {
    connStr := spr("postgres://postgres:@%s:%s/postgres?connect_timeout=5", host, port)
    db := dbConnect("postgres", connStr)
    if isErr(db) {
        pl("PostgreSQL连接失败: %v", getErrStr(db))
    } else {
        pln("PostgreSQL连接成功!")
        
        // 查版本
        rs := dbQuery(db, "SELECT version()")
        if isErr(rs) {
            pl("PostgreSQL查询版本失败: %v", getErrStr(rs))
        } else {
            pl("PostgreSQL版本: %v", rs)
        }
        
        // 查数据库列表
        rs = dbQuery(db, "SELECT datname FROM pg_database")
        if isErr(rs) {
            pl("PostgreSQL pg_database失败: %v", getErrStr(rs))
        } else {
            pl("PostgreSQL数据库列表: %v", rs)
        }
        
        dbClose(db)
    }
} catch e {
    pl("PostgreSQL异常: %v", e)
}
